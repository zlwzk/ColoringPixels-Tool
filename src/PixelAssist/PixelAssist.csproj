<Project Sdk="Microsoft.NET.Sdk">

  <!--
    《涂色大师：像素梦想家》配套的独立「人工辅助」助手。

    该游戏是 IL2CPP 构建，无法像 Coloring Pixels 那样注入 BepInEx 5 插件，
    因此助手做成与游戏完全无关的 WinForms 程序：全局热键 + 模拟鼠标逐行扫描。

    扫描核心（AssistRegion / AssistEngine / AssistStore / AssistWin32）与游戏内插件
    共用同一份源码（以 <Compile Include> 链接进来），保证两边行为一致；
    这些文件刻意不依赖 UnityEngine，可直接被 .NET Framework 编译。

    IDE / dotnet build 用本工程；发布包使用 scripts/build-assist.ps1（用 csc 直接编译）。
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>PixelAssist</AssemblyName>
    <RootNamespace>PixelAssist</RootNamespace>
    <LangVersion>5</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="*.cs" />
    <Compile Include="..\ColoringPixelsTool\AssistRegion.cs" />
    <Compile Include="..\ColoringPixelsTool\AssistEngine.cs" />
    <Compile Include="..\ColoringPixelsTool\AssistStore.cs" />
    <Compile Include="..\ColoringPixelsTool\AssistWin32.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

</Project>
